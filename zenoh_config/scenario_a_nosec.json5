{
  "mode": "router",
  "listen": {
    "endpoints": ["tcp/0.0.0.0:7447"]
  },
  "plugins": {
    "ros2dds": {},
    "rest": {
      "http_port": 8000
    },
    "storage_manager": {
      "volumes": {
        "memory": {}
      },
      "storages": {
        "ros2_store": {
          "key_expr": "**",
          "volume": "memory"
        }
      }
    }
  }
}
