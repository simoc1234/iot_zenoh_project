{
  mode: "router",
  listen: { endpoints: ["tls/127.0.0.1:7447"] },

  transport: {
    link: {
      tls: {
        root_ca_certificate: "/home/simone/iot_zenoh_project/zenoh_certs/ca.crt",
        server_certificate: "/home/simone/iot_zenoh_project/zenoh_certs/server.crt",
        server_private_key: "/home/simone/iot_zenoh_project/zenoh_certs/server.key",
        client_auth: true
      }
    }
  },

  access_control: {
    enabled: true,
    default_permission: "deny",   // tutto cio' che non e' elencato e' negato
    rules: [
      {
        // il client puo' sottoscrivere odom...
        permission: "allow",
        interfaces: ["lo"],
        flows: ["ingress"],
        actions: ["declare_subscriber"],
        key_exprs: ["odom"]
      },
      {
        permission: "allow",
        interfaces: ["lo"],
        flows: ["egress"],
        actions: ["put"],
        key_exprs: ["odom"]
      }
    ]
  },

  plugins_loading: { enabled: true },
  plugins: { ros2dds: {} }
}
